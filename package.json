{
  "name": "coaches-skin-studio",
  "productName": "Coaches Skin Studio",
  "version": "0.2.5",
  "private": true,
  "description": "Independent ETS2 Coaches DLC paint preview studio (no game assets included)",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run dev",
    "preview": "vite preview --host 127.0.0.1",
    "dist:win": "npm run build && electron-builder --win portable",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^34.3.0",
    "electron-builder": "^25.1.8",
    "vite": "^6.2.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.kaeosopha.coaches.skinstudio",
    "productName": "Coaches Skin Studio",
    "directories": {"output": "release"},
    "files": ["dist/**/*", "electron/**/*", "package.json"],
    "asar": true,
    "win": {"target": ["portable"], "artifactName": "Coaches-Skin-Studio-${version}-${arch}.${ext}"}
  }
}

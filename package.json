{
  "name": "coaches-skin-studio",
  "productName": "Coaches Skin Studio",
  "version": "0.4.1",
  "private": true,
  "description": "ETS2 coach livery studio with ready-to-use models and templates",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "start": "npm run dev",
    "preview": "vite preview --host 127.0.0.1",
    "dist:win": "npm run build && electron-builder --win portable",
    "test": "node --test tests/*.test.mjs",
    "test:app": "npm run build && electron tests/app.e2e.cjs"
  },
  "dependencies": {
    "adm-zip": "0.6.1",
    "three": "^0.174.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "45.3.4",
    "electron-builder": "26.18.0",
    "vite": "^6.2.3",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.kaeosopha.coaches.skinstudio",
    "productName": "Coaches Skin Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "Coaches-Skin-Studio-${version}-${arch}.${ext}",
      "icon": "resources/branding/app.ico"
    },
    "extraResources": [
      {
        "from": "resources",
        "to": "studio-resources"
      }
    ]
  }
}
